# Server Configuration
PORT=8000
HOST=127.0.0.1

# Database Configuration
# Use SQLite for simple local development, or PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/larping_app
DATABASE_URL=sqlite:///./larping_app.db

# Authentication Security
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
